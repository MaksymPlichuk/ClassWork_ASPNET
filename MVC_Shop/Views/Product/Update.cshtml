@model CreateProductVM

<div class="d-flex flex-column justify-content-center">

    <h1 class="text-center">Update Form</h1>

    <form class="d-flex flex-column justify-content-center w-75 m-auto"
          method="post"
          asp-controller="Product"
          asp-action="Update"
          enctype="multipart/form-data">
        <div>
            <label for="Name" class="form-label mt-4">Name</label>
            <input asp-for="@Model.Name" type="text" class="form-control" id="Name" name="Name" placeholder="Name">
            <small hidden id="emailHelp" class="form-text text-muted">We'll never share your email with anyone else.</small>
        </div>
        <div>
            <label for="Description" class="form-label mt-4">Description</label>
            <input asp-for="@Model.Description" type="text" class="form-control" id="Description" name="Description" placeholder="Description">
            <small hidden id="emailHelp" class="form-text text-muted">We'll never share your email with anyone else.</small>
        </div>
        <div>
            <label for="Price" class="form-label mt-4">Price</label>
            <input asp-for="@Model.Price" type="number" class="form-control" id="Price" name="Price" placeholder="1500">
            <small hidden id="emailHelp" class="form-text text-muted">We'll never share your email with anyone else.</small>
        </div>
        <div>
            <label for="Amount" class="form-label mt-4">Amount</label>
            <input asp-for="@Model.Amount" type="number" class="form-control" id="Amount" name="Amount" aria-describedby="Amount" placeholder="10">
            <small hidden id="emailHelp" class="form-text text-muted">We'll never share your email with anyone else.</small>
        </div>
        <div>
            <label for="Color" class="form-label mt-4">Color</label>
            <input asp-for="@Model.Color" type="text" class="form-control" id="Color" name="Color" aria-describedby="Color">
            <small hidden id="emailHelp" class="form-text text-muted">We'll never share your email with anyone else.</small>
        </div>
        <div>
            <label for="Image" class="form-label mt-4">Image</label>
            <input type="file" accept="image/*" class="form-control" id="Image" name="Image" aria-describedby="Amount">
            <small hidden id="emailHelp" class="form-text text-muted">We'll never share your email with anyone else.</small>
            <input asp-for="Id" type="hidden">
        </div>
        <div class="mt-3 d-flex justify-content-center">
            <input type="submit" class="btn btn-success w-25 m-auto" value="Add" />
            <a asp-controller="Product" asp-action="Index" class="btn btn-primary w-25 m-auto">Back</a>
        </div>
    </form>
</div>