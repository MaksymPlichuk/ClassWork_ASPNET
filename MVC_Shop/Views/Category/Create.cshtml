@model CreateCategoryVM

<h5 class="text-center">Create Category</h5>
<form class="d-flex flex-column justify-content-center w-50 m-auto bg-body-tertiary p-4" 
      method="post"
      asp-controller="Category"
      asp-action="Create">
    <div class="text-center">
        <label for="Name" class="form-label mt-4">Name</label>
        <input asp-for="Name" type="text" class="form-control" id="Name" name="Name">
        <span asp-validation-for="Name" style="font-size:15px; color:red"></span>
    </div>
    <div class="d-flex justify-content-center">
        <input type="submit" value="Create" class="btn btn-success mt-3 w-50"/>
    </div>
</form>

