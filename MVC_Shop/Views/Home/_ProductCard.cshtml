@model ProductModel
@inject IHttpContextAccessor ContextAccessor

<div class="card col-3 @(Model.Amount == 0 ? "opacity-50" : "")" style="width: 18rem;">
    <img height="300" width="250" style="object-fit: contain;" class="card-img-top" src="~/images/@(Model.Image ?? "default.jpg")" alt="@Model.Name">
    <div class="card-body">
        <h5 class="card-title">@Model.Name</h5>
        <h4>@(Model.Amount != 0 ? $"$ {Model.Price}" : "Немає в наявності")</h4>
        <div class="d-flex flex-row">
            <div class="flex-grow-1">
                <a asp-action="Description" asp-route-id="@Model.Id" class="btn btn-primary">More</a>
            </div>
            <div class="flex-grow-0">
                @if (CartService.IsInCart(ContextAccessor.HttpContext.Session, Model.Id))
                {
                    <a asp-controller="Cart" asp-action="Add" asp-route-id="@Model.Id" class="text-success" style="font-size:20px"><i class="bi bi-cart-fill"></i></a>
                }
                else
                {
                    <a asp-controller="Cart" asp-action="Add" asp-route-id="@Model.Id" class="text-success" style="font-size:20px"><i class="bi bi-cart"></i></a>
                }
            </div>

        </div>
    </div>
</div>