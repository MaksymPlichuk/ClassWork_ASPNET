@model HomeVM
@{
    ViewData["Title"] = "Home Page";
}

<div class="d-flex">
    <aside class="flex-grow-0 border-end p-5">
        @foreach (var category in Model.Categories)
        {
            <a asp-action="Index" asp-route-c="@category.Id" class="d-block mb-2 side-link">@category.Name</a>
        }
    </aside>
    <main class="flex-grow-1 p-5">
        <div class="row gap-2 mx-auto">
            @foreach (var prod in Model.Products)
            {
                <partial name="_ProductCard" model="@prod"></partial>
            }
        </div>

        <div class="mt-4 d-flex  justify-content-center">
            <nav aria-label="...">
                <ul class="pagination">
                    @if (Model.Pagination.PageCount != 1)
                    {
                        @if (Model.Pagination.Page != 1)
                        {
                            <li class="page-item">
                                <a asp-action="Index" asp-route-page="1" asp-route-c="@Model.CategoryId" class="page-link">
                                    <i class="bi bi-chevron-double-left"></i>
                                </a>
                            </li>
                            <li class="page-item">
                                <a asp-action="Index" asp-route-page="@(Model.Pagination.Page - 1)" asp-route-c="@Model.CategoryId" class="page-link">
                                    <i class="bi bi-chevron-left"></i>
                                </a>
                            </li>
                        }


                        @for (int i = 1; i < Model.Pagination.PageCount; i++)
                        {
                            <li class="page-item @(Model.Pagination.Page == i ? "active" : "")">
                                <a class="page-link" asp-action="Index" asp-route-c="@Model.CategoryId" asp-route-page="@i" aria-current="page">@i</a>
                            </li>
                        }

                        @if (Model.Pagination.Page != Model.Pagination.PageCount)
                        {
                            <li class="page-item">
                                <a asp-action="Index" asp-route-page="@(Model.Pagination.Page + 1)" asp-route-c="@Model.CategoryId" class="page-link">
                                    <i class="bi bi-chevron-right"></i>
                                </a>
                            </li>
                            <li class="page-item">
                                <a asp-action="Index" asp-route-page="@Model.Pagination.PageCount" asp-route-c="@Model.CategoryId" class="page-link">
                                    <i class="bi bi-chevron-double-right"></i>
                                </a>
                            </li>
                        }
                    }
                </ul>
            </nav>
        </div>
    </main>
</div>
