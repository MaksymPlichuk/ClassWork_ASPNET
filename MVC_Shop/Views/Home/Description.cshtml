@model ProductModel

<div class="d-flex justify-content-center mt-4">
    <aside class="flex-grow-0 border-end p-5">
        <img src="~/images/@(Model.Image ?? "default.jpg")" alt="@Model.Name" style="max-width: 710px"/>
    </aside>
    <main class="flex-grow-1 p-5">
        <div class="row gap-2 mx-auto">
            <h2>
                @Model.Name
            </h2>
            <h3>@Model.Category.Name </h3>
            <h5> Date: @Model.CreatedDate </h5>
            <h5> Ammount: @Model.Amount</h5>
            <h5> Price: $ @Model.Price</h5>
            <h5> Color: @Model.Color </h5>
            <h3> @Model.Description </h3>
        </div>
    </main>
</div>